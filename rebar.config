%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_embed

{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% No deps. The ollama backend uses httpc, already an OTP application this
%% app depends on.
{deps, []}.

%% rustler / rebar3_cargo are deliberately NOT deps: rustler 0.34 pulls in
%% mix-only transitives rebar3 cannot build. The NIF's Erlang side needs no
%% rustler at all, and the .so is built by `scripts/build-nif.sh', which runs
%% cargo directly.
%%
%% THE NIF BUILDS WHEREVER THIS APP IS COMPILED, including as a dependency:
%% rebar3 runs an app's own hooks when it compiles it, so a consumer needs a
%% Rust toolchain and nothing else. CARGO_FEATURES=real-embed in the
%% consumer's build environment selects the real fastembed/ONNX backend;
%% unset, it builds the deterministic hash stub.
{pre_hooks, [{compile, "bash scripts/build-nif.sh"}]}.
%% PINNED, both of them. rebar3_hex 7.3.0 stopped reading HEX_API_KEY, so an
%% unpinned plugin turns a CI publish into a bare badmatch; and the pin lives
%% in this file, inside the tag, so a re-run of a failed release cannot fix it.
{project_plugins, [
    {rebar3_hex, "~> 7.2.0"},
    {rebar3_ex_doc, "0.3.0"}
]}.

{shell, [
    {apps, [mcl_embed]}
]}.

%% Pure library: no release. Consumers (mcl-embedder, etc.) link this app
%% and build their own release. A standalone per-node "mcl-embed as its own
%% service" mode existed here and was removed — see CHANGELOG.

{hex, [
    {name, mcl_embed},
    {doc, #{provider => ex_doc}},
    {licenses, ["Apache-2.0"]},
    {links, #{
        <<"GitHub">> => <<"https://github.com/macula-services/mcl-embed">>
    }},
    %% The package's file list lives in src/mcl_embed.app.src: rebar3_hex
    %% reads it there and ignores one here.
    {description, "Local multilingual sentence embeddings (Rustler NIF over fastembed-rs, ONNX)"}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-services/mcl-embed">>},
    {extras, ["README.md", "CHANGELOG.md", "LICENSE", "guides/getting_started.md"]},
    {main, "README.md"}
]}.

{profiles, [
    {lint, [
        {plugins, [{rebar3_lint, "5.0.4"}]}
    ]}
]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [ #{files => ["src/**/*.erl"], ruleset => macula_min} ]}
]}.
