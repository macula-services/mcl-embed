{application, mcl_embed, [
    {description, "Local multilingual sentence embeddings (Rustler NIF or Ollama HTTP backend)"},
    {vsn, "0.1.0"},
    {registered, [mcl_embed_sup, mcl_embed_model_sup]},
    {mod, {mcl_embed_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        inets,
        ssl
    ]},
    {env, [
        {default_model_id, <<"intfloat/multilingual-e5-small">>},
        {default_dim, 384},
        {model_dir, "priv/models"},
        %% Backend for the default model: nif (in-process ONNX) or ollama (HTTP
        %% to an Ollama daemon).
        {backend, nif},
        {ollama_url, "http://127.0.0.1:11434/api/embeddings"}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/macula-services/mcl-embed"}
    ]},
    %% WHAT THE HEX PACKAGE CARRIES. rebar3_hex reads this list here, in the
    %% .app.src, and ignores one in rebar.config. The Rust crate and its build
    %% script must ship: the NIF is compiled on the consumer, by this app's
    %% own pre_hooks. Built artefacts (target/, priv/lib/) must not.
    {files, ["src", "rebar.config", "README.md", "CHANGELOG.md", "LICENSE",
             "guides",
             "native/mcl_embed_nif/Cargo.toml", "native/mcl_embed_nif/README.md",
             "native/mcl_embed_nif/src",
             "scripts/build-nif.sh", "scripts/fetch-model.sh",
             "scripts/prefetch-model.sh"]}
]}.
